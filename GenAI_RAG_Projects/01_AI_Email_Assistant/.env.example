# Copy this file to .env (in the project root) and fill in ONLY the provider you use.
# .env is read by backend/app.py at start-up. Never commit .env to Git (add it to .gitignore).

# mock (default, free, offline) | openai | anthropic
LLM_PROVIDER=mock

# Any OpenAI-compatible /chat/completions endpoint (OpenAI, Groq, Together, a local Ollama server, ...)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
